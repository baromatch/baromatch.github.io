{
  "name": "baromatch-site",
  "private": true,
  "description": "Outils de vérification du site baromatch.fr (rien de tout ça n'est servi aux visiteurs).",
  "scripts": {
    "serve": "http-server . -p 4173 -a 127.0.0.1 -s -c-1",
    "test": "playwright test",
    "lighthouse": "node tests/outils/lighthouse.mjs",
    "liens": "playwright test tests/liens.spec.mjs",
    "generer": "node generateur/construire.mjs",
    "generer:capture": "node generateur/construire.mjs --source=capture:tests/donnees/capture --maintenant=2026-10-15T19:44:29Z --sortie=apercu",
    "lighthouse:exemples": "node tests/outils/lighthouse-exemples.mjs",
    "mesure": "node generateur/mesure.mjs",
    "lighthouse:mesure": "node tests/outils/lighthouse-mesure.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "http-server": "14.1.1",
    "lighthouse": "13.5.0"
  }
}
